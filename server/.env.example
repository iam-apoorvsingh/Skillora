# Skillora Server — Environment Variables
# Copy this file to .env and fill in values before running.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Tokens ───────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_strong_64_byte_hex_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_different_strong_64_byte_hex_secret_for_refresh

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (Vite dev server + production URL)
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Leaderboard Bayesian Prior ───────────────────────────────────────────────
# C = confidence weight (minimum number of reviews before rating is meaningful)
BAYESIAN_PRIOR_COUNT=5
# m = prior mean (global average rating assumed before any reviews)
BAYESIAN_PRIOR_MEAN=3.5

# ─── Session Minimum Duration (minutes) before rating unlocks ─────────────────
MIN_SESSION_DURATION_MINUTES=20

# ─── Institution Domain ────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=iiitnr.edu.in
